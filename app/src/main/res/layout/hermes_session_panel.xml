<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome Remote Desktop-style session menu, shown as a sheet sliding in from the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/hermes_ic_desktop"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/panelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hermes_session_connected"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/panelClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hermes_session_close"
            android:src="@drawable/hermes_ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionKeyboard"
                style="@style/Hermes.PanelRow"
                android:text="@string/hermes_show_keyboard"
                app:icon="@drawable/hermes_ic_keyboard" />

            <!-- Mouse input -->
            <TextView
                style="@style/Hermes.SectionHeader"
                android:text="@string/hermes_section_input" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/inputModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inputTrackpad"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hermes_input_trackpad"
                    app:icon="@drawable/hermes_ic_mouse" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inputTouch"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hermes_input_touch"
                    app:icon="@drawable/hermes_ic_touch" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/inputModeHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Keys -->
            <TextView
                style="@style/Hermes.SectionHeader"
                android:text="@string/hermes_section_keys" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/keysGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:chipSpacingVertical="0dp" />

            <!-- Display -->
            <TextView
                style="@style/Hermes.SectionHeader"
                android:text="@string/hermes_section_display" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/scaleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scaleFit"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hermes_scale_fit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scaleFill"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hermes_scale_fill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scaleStretch"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hermes_scale_stretch" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchZoom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/hermes_zoom_pan"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchStats"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/hermes_stats"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionRotate"
                style="@style/Hermes.PanelRow"
                android:text="@string/hermes_rotate"
                app:icon="@drawable/hermes_ic_rotate" />

            <!-- Clipboard -->
            <TextView
                style="@style/Hermes.SectionHeader"
                android:text="@string/hermes_section_clipboard" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionClipboardSend"
                style="@style/Hermes.PanelRow"
                android:text="@string/hermes_clipboard_send"
                app:icon="@drawable/hermes_ic_paste" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionClipboardGet"
                style="@style/Hermes.PanelRow"
                android:text="@string/hermes_clipboard_get"
                app:icon="@drawable/hermes_ic_copy" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionServerCommands"
                style="@style/Hermes.PanelRow"
                android:text="@string/hermes_server_commands"
                app:icon="@drawable/hermes_ic_terminal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionMore"
                style="@style/Hermes.PanelRow"
                android:text="@string/hermes_more_session_options"
                app:icon="@drawable/hermes_ic_tune" />
        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionEndSession"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hermes_end_session"
            android:textColor="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionDisconnect"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/hermes_disconnect"
            app:icon="@drawable/hermes_ic_logout" />
    </LinearLayout>
</LinearLayout>
